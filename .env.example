# codex: local Codex CLI; demo: offline; live: DeepSeek Harness.
RESEARCH_MODE=codex
PORT=3088
DATA_DIR=./data
CODEX_COMMAND=codex
CODEX_TRANSPORT=pty
CODEX_WORK_ROOT=./data/codex
CODEX_TIMEOUT_MS=600000
# Omit CODEX_MODEL to use your existing CLI model configuration.
# CODEX_MODEL=
# Feishu writes/auth are owned by the terminal Agent via local lark-cli.
# No platform OAuth token or PUBLISH_MODE configuration is required.
# Live runtime: executable + JSON array, never interpreted by a shell.
HARNESS_COMMAND=dsh
HARNESS_ARGS=["--profile","sdk"]
HARNESS_PROVIDER=deepseek-official
HARNESS_MODEL=deepseek-v4-flash
HARNESS_TIMEOUT_MS=600000
# Use a dedicated SDK profile/home with approved search tools and restricted permissions.
HARNESS_HOME=./data/harness
